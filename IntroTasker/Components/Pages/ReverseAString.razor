@page "/reverse-a-string"

<PageTitle>Reverse A String</PageTitle>

<h3>Reverse A String</h3>

<div class="vstack gap-3 col-8 col-md-6">
    <InputText class="form-control" placehoder="Enter a string to reverse" @bind-Value="inputString" />
    <div class="text_end">
        <button class="btn btn-primary" @onclick="ReverseString">Reverse Me</button>
    </div>
    <hr />
    <div>@displayString</div>
</div>

@code {

    private string inputString = "Reverse Me";
    private string reversedString = string.Empty;
    private string displayString = string.Empty;

    private void ReverseString()
    {
        reversedString = string.Empty;
        for(int i = inputString.Length - 1; i >= 0; i--)
        {
            reversedString += inputString[i];
        }
        displayString = $"The reversed string is: {reversedString}";
    }
}

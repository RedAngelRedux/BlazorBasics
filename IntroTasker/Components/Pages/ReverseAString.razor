@page "/reverse-a-string"
@using System.Text.RegularExpressions

<PageTitle>Reverse A String</PageTitle>

<h3>Reverse A String</h3>

<div class="vstack gap-3 col-8 col-md-6">
    <InputText class="form-control" placehoder="Enter a string to reverse" @bind-Value="inputString" />
    <div class="text_end">
        <button class="btn btn-primary" @onclick="ReverseString">Reverse Me</button>
    </div>
    <hr />
    <Message DisplayMessage="@displayString" Title=@title CssClass="@cssClass"/>
</div>

@code {

    private string inputString = "Reverse Me";
    private string reversedString = string.Empty;
    private string displayString = string.Empty;
    private bool isPalindrome = false;
    private string cssClass = "alert-success";
    private string title = "Results";

    private void ReverseString()
    {
        reversedString = ReverseString(inputString);
        displayString = $"REVERSED STRING:  {reversedString}";

        isPalindrome = IsPalindrome(inputString);
        if(isPalindrome)
        {
            title= "Palindrome";
            cssClass = "alert-success";
        }
        else
        {
            title = "Not a Palindrome";
            cssClass = "alert-danger";
        }
    }

    private string ReverseString(string input)
    {
        string reversedString = string.Empty;
        for(int i = input.Length - 1; i >= 0; i--)
        {
            reversedString += input[i];
        }
        return reversedString;
    }

    private bool IsPalindrome(string input)
    {
        // Remove all non-alphanumeric characters and convert to lowercase
        string cleanedInput = Regex.Replace(input, "[^a-zA-Z0-9]", "").ToLower();        
        return cleanedInput == ReverseString(cleanedInput);
    }

}
